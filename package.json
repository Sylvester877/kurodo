{
  "name": "kurodo",
  "private": true,
  "version": "0.3.10",
  "type": "module",
  "main": "electron/main.js",
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.5",
    "animepahe-api": "github:ElijahCodes12345/animepahe-api",
    "aniwatch": "^2.27.9",
    "axios": "^1.17.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^11.11.17",
    "hls.js": "^1.5.17",
    "lenis": "^1.3.25",
    "lucide-react": "^0.460.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "swiper": "^11.1.15",
    "tailwind-merge": "^2.5.4",
    "webtorrent": "^3.0.16",
    "zustand": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sylvester877/kurodo.git"
  },
  "description": "Discover & stream anime — a fast, keyboard-first anime streaming app with AniList integration, multi-provider scraper, PWA and desktop support.",
  "author": "Kurōdo",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "electron:dev": "concurrently \"node server/index.js\" \"vite\" \"electron .\"",
    "electron:build": "vite build && electron-builder --win --publish always",
    "electron:build:win": "vite build && electron-builder --win --publish always",
    "start": "node server/index.js"
  },
  "build": {
    "appId": "com.kurodo.app",
    "productName": "Kurodo",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "server/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Kurodo-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kurodo",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "Sylvester877",
      "repo": "kurodo"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron-builder": "^25.0.0",
    "concurrently": "^9.0.0",
    "vite": "^6.0.0",
    "typescript": "^5.7.0"
  }
}
